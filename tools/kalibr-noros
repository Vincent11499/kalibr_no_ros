#!/usr/bin/env python3
"""Relocatable entry point for the ROS-free Kalibr application."""

import os
from pathlib import Path
import sys


prefix = Path(__file__).resolve().parents[1]
library_dir = str(prefix / "lib")
library_paths = [
    path for path in os.environ.get("LD_LIBRARY_PATH", "").split(os.pathsep)
    if path
]
if not library_paths or library_paths[0] != library_dir:
    environment = os.environ.copy()
    environment["LD_LIBRARY_PATH"] = os.pathsep.join(
        [library_dir] + [path for path in library_paths if path != library_dir]
    )
    os.execve(
        sys.executable,
        [sys.executable, str(Path(__file__).resolve())] + sys.argv[1:],
        environment,
    )

for candidate in (
    prefix / "python",
    prefix / "lib" / "python3" / "dist-packages",
):
    if candidate.is_dir():
        sys.path.insert(0, str(candidate))

from kalibr_no_ros.cli import main


if __name__ == "__main__":
    raise SystemExit(main(prefix=prefix))
