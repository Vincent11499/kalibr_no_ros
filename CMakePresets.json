{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "KALIBR_USE_PRIVATE_DEPS": "ON",
        "KALIBR_ENABLE_PROFILING": "OFF"
      }
    },
    {
      "name": "project-profile",
      "inherits": "release",
      "cacheVariables": {
        "KALIBR_ENABLE_PROFILING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "project-profile",
      "configurePreset": "project-profile",
      "jobs": 4
    }
  ]
}
